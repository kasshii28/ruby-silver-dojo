---
import Layout from '../layouts/Layout.astro';
import { EXAMS, SITE_NAME } from '../lib/exams';
import { loadQuestions } from '../lib/questions';

const exams = EXAMS.map((exam) => {
  const questions = loadQuestions(exam);
  const official = questions.filter((q) => q.official !== undefined).length;
  return { exam, total: questions.length, official, original: questions.length - official };
});
---

<Layout title={SITE_NAME} description="資格試験のオリジナル問題と公式模擬問題を1問ずつ解いて、その場で正解と解説を確認できる学習サイト。">
  <div class="wrap">
    <header class="top">
      <div class="brand">
        <a href="/"><h1><span class="gem" aria-hidden="true"></span>{SITE_NAME}</h1></a>
        <small>資格試験の問題を1問ずつ解いて、その場で解説を確認</small>
      </div>
    </header>

    <main>
      <p class="intro">学習する試験を選んでください。出題順と選択肢の並びは毎回ランダムで、学習記録と受験履歴は試験ごとにこのブラウザに保存されます。</p>
      <section class="panel" aria-labelledby="h-certs">
        <div class="panel-head"><h2 id="h-certs">試験を選ぶ</h2></div>
        <ul class="certs">
          {exams.map(({ exam, total, official, original }) => (
            <li>
              <a class="cert" href={`/${exam.slug}/`} data-storage={exam.storage} data-total={total}>
                <span class="cert-name"><span class="gem" aria-hidden="true"></span>{exam.name}</span>
                <span class="cert-sub">{exam.fullName}・{exam.version}</span>
                <span class="cert-count">オリジナル {original} 問＋公式模擬問題 {official} 問</span>
                <span class="cert-progress" hidden></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer>
      公式模擬問題以外の問題はこのサイトのオリジナルです。公式模擬問題は <a href="https://github.com/ruby-association/prep-test" target="_blank" rel="noopener">Ruby Association のサンプル問題</a>をもとに誤記を修正したもので、解説はこのサイトで書き下ろしています。
    </footer>
  </div>

  <script>
    import '../client/portal';
  </script>
</Layout>
