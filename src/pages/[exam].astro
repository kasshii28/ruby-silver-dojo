---
import Layout from '../layouts/Layout.astro';
import { embedJson } from '../lib/embed';
import { EXAMS, SITE_NAME, examInfo, type Exam } from '../lib/exams';
import { loadQuestions } from '../lib/questions';

export function getStaticPaths() {
  return EXAMS.map((exam) => ({ params: { exam: exam.slug }, props: { exam } }));
}

const { exam } = Astro.props as { exam: Exam };
const questions = loadQuestions(exam);
const official = questions.filter((q) => q.official !== undefined).length;
const original = questions.length - official;
---

<Layout
  title={`${exam.name}｜${SITE_NAME}`}
  description={`${exam.fullName}のオリジナル問題と公式模擬問題を1問ずつ解いて、その場で正解と解説を確認できる学習サイト。`}
>
  <div class="wrap">
    <header class="top">
      <div class="brand">
        <a href="/" class="site">← {SITE_NAME}（試験の一覧）</a>
        <a href="#home"><h1><span class="gem" aria-hidden="true"></span>{exam.name}</h1></a>
        <small>{exam.version}対応・オリジナル{original}問＋公式模擬問題{official}問</small>
      </div>
    </header>

    <main id="main"></main>

    <footer>
      公式模擬問題以外の問題はこのサイトのオリジナルです。公式模擬問題は <a href="https://github.com/ruby-association/prep-test" target="_blank" rel="noopener">Ruby Association のサンプル問題</a>をもとに誤記を修正したもので、解説はこのサイトで書き下ろしています。コードは実際に Ruby で実行し、正解が実行結果と一致することを確かめています（試験の対象は Ruby 3.1、確認は Ruby 3.3）。本試験は {exam.size} 問・{exam.minutes} 分・正答率 {exam.pass}% で合格です。学習記録と受験履歴はこのブラウザにだけ保存されます。
    </footer>
  </div>

  <script is:inline id="exam" type="application/json" set:html={embedJson(examInfo(exam))}></script>
  <script is:inline id="qdata" type="application/json" set:html={embedJson(questions)}></script>
  <script>
    import '../client/main';
  </script>
</Layout>
